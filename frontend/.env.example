# Copy this file to .env (same folder) for local development, or set these
# under your Vercel frontend project's Environment Variables.

# Leave EMPTY for local dev - Vite proxies /api to http://127.0.0.1:8000
# automatically (see vite.config.js).
#
# In production (frontend deployed as its own Vercel project), set this to
# your backend project's full URL, e.g.:
# VITE_API_BASE_URL=https://your-backend.vercel.app/api
VITE_API_BASE_URL=

# Only needed if you set DASHBOARD_API_KEY on the backend.
VITE_DASHBOARD_API_KEY=
