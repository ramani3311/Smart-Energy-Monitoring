# Copy this file to .env (same folder) for local development.
# On Vercel, add these under Project Settings -> Environment Variables instead.

# --- MongoDB (required) ---
# Get this from MongoDB Atlas: Database -> Connect -> Drivers -> Python
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=energy_monitoring

# --- Weather (required for the "Refresh weather" button) ---
# Free API key: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Hardware / relay control ---
# "none"    = simulated (default) - relay commands just update MongoDB
# "webhook" = forwards the command to your real Gateway's HTTP endpoint
HARDWARE_MODE=none
GATEWAY_WEBHOOK_URL=
GATEWAY_API_KEY=
GATEWAY_TIMEOUT_SECONDS=6

# --- Optional write protection ---
# If set, all POST/PATCH/DELETE requests must send:
#   Authorization: Bearer <DASHBOARD_API_KEY>
DASHBOARD_API_KEY=

# --- CORS ---
# Set to your deployed frontend's exact URL in production, e.g.
# https://your-dashboard.vercel.app
# Leave as * for local development.
FRONTEND_ORIGIN=*
